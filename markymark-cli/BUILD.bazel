load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//:version.bzl", "VERSION")

# Filegroup for integration tests that read tests/corpus/ at runtime.
# Using a filegroup lets rust_test rules reference the set as a single label
# `:corpus` with `$(rlocationpath :corpus)` pointing at the corpus root.
filegroup(
    name = "corpus",
    srcs = glob(["tests/corpus/**"]),
)

rust_binary(
    name = "markymark",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "markymark",
    version = VERSION,
    crate_features = [
        "semantic-search",
        "local-embeddings",
    ],
    deps = [
        "//markymark-core",
        "//markymark-lsp",
        "//markymark-mcp",
        "@crates//:tokio",
        "@crates//:anyhow",
        "@crates//:clap",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "markymark-cli_test",
    crate = ":markymark",
    deps = [
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)

# Integration tests under tests/*.rs — each file gets its own rust_test target.
# See marky-lpz for the pattern.
#
# Tests that spawn the built binary declare `:markymark` as a `data` dep and
# export `MARKYMARK_BIN` via `rustc_env` so the test can locate it inside the
# runfiles tree. The test's markymark_bin() helper honours the env var first
# and falls back to cargo's current_exe() derivation when unset.
#
# Tests that read tests/corpus/ declare `tests/corpus/**` as data and export
# `MARKYMARK_CORPUS_DIR` similarly. corpus_dir() helpers use the same
# env-first / CARGO_MANIFEST_DIR-fallback pattern.

rust_test(
    name = "cli_args",
    srcs = ["tests/cli_args.rs"],
    edition = "2021",
    data = [":markymark"],
    env = {"MARKYMARK_BIN": "$(rootpath :markymark)"},
    timeout = "long",
)

rust_test(
    name = "smoke_lsp",
    srcs = ["tests/smoke_lsp.rs"],
    edition = "2021",
    data = [":markymark"],
    env = {"MARKYMARK_BIN": "$(rootpath :markymark)"},
    deps = ["@crates//:serde_json"],
    timeout = "long",
)

rust_test(
    name = "smoke_mcp",
    srcs = ["tests/smoke_mcp.rs"],
    edition = "2021",
    data = [
        ":markymark",
        ":corpus",
        # Anchor file for MARKYMARK_CORPUS_DIR: $(rlocationpath) needs a
        # single-file label, so we list basic.md explicitly alongside the
        # broader :corpus filegroup. Test's corpus_dir() strips the filename.
        "tests/corpus/basic.md",
    ],
    env = {
        "MARKYMARK_BIN": "$(rootpath :markymark)",
        "MARKYMARK_CORPUS_DIR": "$(rootpath tests/corpus/basic.md)",
    },
    deps = ["@crates//:serde_json"],
    timeout = "long",
)

rust_test(
    name = "lsp_methods",
    srcs = ["tests/lsp_methods.rs"],
    edition = "2021",
    data = [
        ":markymark",
        ":corpus",
        # Anchor file for MARKYMARK_CORPUS_DIR: $(rlocationpath) needs a
        # single-file label, so we list basic.md explicitly alongside the
        # broader :corpus filegroup. Test's corpus_dir() strips the filename.
        "tests/corpus/basic.md",
    ],
    env = {
        "MARKYMARK_BIN": "$(rootpath :markymark)",
        "MARKYMARK_CORPUS_DIR": "$(rootpath tests/corpus/basic.md)",
    },
    deps = ["@crates//:serde_json"],
    timeout = "long",
)

rust_test(
    name = "mcp_methods",
    srcs = ["tests/mcp_methods.rs"],
    edition = "2021",
    data = [
        ":markymark",
        ":corpus",
        # Anchor file for MARKYMARK_CORPUS_DIR: $(rlocationpath) needs a
        # single-file label, so we list basic.md explicitly alongside the
        # broader :corpus filegroup. Test's corpus_dir() strips the filename.
        "tests/corpus/basic.md",
    ],
    env = {
        "MARKYMARK_BIN": "$(rootpath :markymark)",
        "MARKYMARK_CORPUS_DIR": "$(rootpath tests/corpus/basic.md)",
    },
    deps = ["@crates//:serde_json"],
    timeout = "long",
)

rust_test(
    name = "alignment",
    srcs = [
        "tests/alignment.rs",
        "tests/alignment_support/mod.rs",
    ],
    edition = "2021",
    data = [
        ":markymark",
        ":corpus",
        # Anchor file for MARKYMARK_CORPUS_DIR: $(rlocationpath) needs a
        # single-file label, so we list basic.md explicitly alongside the
        # broader :corpus filegroup. Test's corpus_dir() strips the filename.
        "tests/corpus/basic.md",
    ],
    env = {
        "MARKYMARK_BIN": "$(rootpath :markymark)",
        "MARKYMARK_CORPUS_DIR": "$(rootpath tests/corpus/basic.md)",
    },
    deps = ["@crates//:serde_json"],
    # Alignment tests spawn both markymark and marksman (system binary at
    # /opt/homebrew/bin). Under Bazel sandbox, marksman's LSP handshake
    # fails with "no Content-Length header found" — sandbox isolation
    # likely blocks marksman's stdio or filesystem access pattern. Tag
    # manual so wildcard `bazel test //...` stays green. Run explicitly
    # under Bazel or via cargo for dev workflow.
    tags = ["manual"],
    timeout = "long",
)

rust_test(
    name = "bench_lsp",
    srcs = [
        "tests/bench_lsp.rs",
        "tests/alignment_support/mod.rs",
    ],
    edition = "2021",
    data = [
        ":markymark",
        ":corpus",
        # Anchor file for MARKYMARK_CORPUS_DIR: $(rlocationpath) needs a
        # single-file label, so we list basic.md explicitly alongside the
        # broader :corpus filegroup. Test's corpus_dir() strips the filename.
        "tests/corpus/basic.md",
    ],
    env = {
        "MARKYMARK_BIN": "$(rootpath :markymark)",
        "MARKYMARK_CORPUS_DIR": "$(rootpath tests/corpus/basic.md)",
    },
    deps = ["@crates//:serde_json"],
    # Benchmark (2 warmup + 10 measured iterations per method) — tag manual
    # so it's excluded from `bazel test //...`. Run explicitly:
    # `bazel test //markymark-cli:bench_lsp`.
    tags = ["manual"],
    timeout = "long",
)

rust_test(
    name = "triage_consistency",
    srcs = ["tests/triage_consistency.rs"],
    edition = "2021",
    data = ["//:docs/research/marksman-alignment-triage.md"],
    env = {
        "MARKYMARK_TRIAGE_DOC": "$(rootpath //:docs/research/marksman-alignment-triage.md)",
    },
)
