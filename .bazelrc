# ── Common ────────────────────────────────────────────────────────────────────
common          --enable_platform_specific_config

# CC toolchain settings required by toolchains_llvm_bootstrapped
common          --experimental_cc_static_library
common          --experimental_cc_shared_library
common          --incompatible_use_cc_configure_from_rules_cc
common          --experimental_starlark_cc_import
common          --compiler=clang

# Use CC linker for Zig code (prevents -pthread and other CC flag leaks)
common          --@rules_zig//zig/settings:use_cc_common_link=True

# LLVM backend for Zig (self-hosted backend is fragile)
common          --@rules_zig//zig/settings:zigopt=-fllvm

# macOS configuration
common:macos    --action_env=MACOSX_DEPLOYMENT_TARGET=13.0
common:macos    --macos_sdk_version=13.0
# Use system LLD (Homebrew LLVM) for CC linking — enables cross-language LTO.
# Apple ld doesn't support cross-language LTO; system ld64.lld does.
common:macos    --linkopt=-fuse-ld=/opt/homebrew/bin/ld64.lld
common:macos    --linkopt=-flto=thin

# Disable libtool on macOS (required for rules_rust cross-compilation)
build           --@rules_cc//cc/toolchains/args/archiver_flags:use_libtool_on_macos=False

# rules_rust bootstrap
build           --@rules_rust//rust/settings:experimental_use_sh_toolchain_for_bootstrap_process_wrapper
# Stub libgcc_s for hermetic LLVM — rustc injects -lgcc_s but the hermetic
# sysroot uses compiler-rt. This provides an empty stub so the link succeeds.
build           --@toolchains_llvm_bootstrapped//config:experimental_stub_libgcc_s=True

# Runfiles support
common          --enable_runfiles

# Mount zig cache into sandboxes
build:macos     --sandbox_add_mount_pair=/var/tmp
build:linux     --sandbox_add_mount_pair=/tmp

# ort-sys (ONNX Runtime) needs HOME to locate its download cache
build           --action_env=HOME

# Print test errors in console
test            --test_output=errors

# ── Release config (cross-language ThinLTO — all platforms) ───────────────────
build:release   --compilation_mode=opt
build:release   --copt=-flto=thin
build:release   --linkopt=-flto=thin
build:release   --@rules_rust//:extra_rustc_flags=-Clinker-plugin-lto,-Ccodegen-units=1,-Cembed-bitcode=yes
build:release   --strip=always

# ── macOS LTO (use with: --config=release --config=macos-lto) ────────────────
# Routes rustc link through Homebrew clang + ld64.lld.
# clang-lto-wrapper strips -plugin-opt args that ld64.lld rejects.
# extra_rustc_flag (singular) ACCUMULATES with extra_rustc_flags (plural).
build:macos-lto --@rules_zig//zig/settings:zigopt=-femit-llvm-bc
build:macos-lto --@rules_rust//rust/settings:extra_rustc_flag=-Clinker=/opt/homebrew/opt/llvm/bin/clang-lto-wrapper
build:macos-lto --@rules_rust//rust/settings:extra_rustc_flag=-Clink-arg=-fuse-ld=/opt/homebrew/bin/ld64.lld
build:macos-lto --@rules_rust//rust/settings:extra_rustc_flag=-Clink-arg=-flto=thin
