load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

_LSP_DEPS = [
    "//markymark-core",
    "//markymark-index",
    "//markymark-kernels",
    "//markymark-parser",
    "@crates//:tower-lsp-server",
    "@crates//:lsp-types",
    "@crates//:tokio",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "@crates//:anyhow",
    "@crates//:log",
]

rust_library(
    name = "markymark-lsp",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "markymark_lsp",
    deps = _LSP_DEPS,
    visibility = ["//visibility:public"],
)

# Integration tests enable the `test-helpers` feature (see Cargo.toml
# [dev-dependencies]: `markymark-lsp = { path = ".", features = ["test-helpers"] }`).
# Creates a parallel compilation of markymark_lsp with drain_pending/try_apply_drained
# exposed on Backend — needed for deterministic debounce testing.
rust_library(
    name = "markymark-lsp-testing",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "markymark_lsp",
    crate_features = ["test-helpers"],
    deps = _LSP_DEPS,
    testonly = True,
)

rust_test(
    name = "markymark-lsp_test",
    crate = ":markymark-lsp",
    deps = [
        "@crates//:insta",
    ],
)

# Integration tests under tests/*.rs — each file gets its own rust_test target.
# All depend on :markymark-lsp-testing (test-helpers feature) matching Cargo's
# dev-dep setup. See marky-lpz for the pattern.

_LSP_INTEGRATION_DEPS = [
    ":markymark-lsp-testing",
    "//markymark-core",
    "@crates//:tokio",
]

_LSP_SERVER_TEST_DEPS = _LSP_INTEGRATION_DEPS + [
    "@crates//:tower-lsp-server",
]

rust_test(
    name = "capabilities_test",
    srcs = ["tests/capabilities.rs"],
    edition = "2021",
    deps = _LSP_SERVER_TEST_DEPS,
)

rust_test(
    name = "completion_acceptance_test",
    srcs = ["tests/completion_acceptance.rs"],
    edition = "2021",
    deps = _LSP_INTEGRATION_DEPS,
)

