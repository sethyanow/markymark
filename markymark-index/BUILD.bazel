load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

_INDEX_DEPS = [
    "//markymark-core",
    "//markymark-kernels",
    "//markymark-parser",
    "@crates//:petgraph",
    "@crates//:bumpalo",
    "@crates//:hashbrown",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "@crates//:tree-sitter",
    "@crates//:self_cell",
    "@crates//:log",
    "@crates//:lasso",
]

_INDEX_PROC_MACRO_DEPS = [
    "@crates//:async-trait",
]

rust_library(
    name = "markymark-index",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "markymark_index",
    crate_features = ["embeddings"],
    deps = _INDEX_DEPS + ["@crates//:tokio"],
    proc_macro_deps = _INDEX_PROC_MACRO_DEPS,
    visibility = ["//visibility:public"],
)

# Feature-gated variant exposing bench_corpus/bench_config for benchmarks
rust_library(
    name = "markymark-index-bench",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "markymark_index",
    crate_features = ["bench-internals"],
    deps = _INDEX_DEPS,
    proc_macro_deps = _INDEX_PROC_MACRO_DEPS,
    testonly = True,
)

rust_test(
    name = "markymark-index_test",
    crate = ":markymark-index",
    deps = [
        "@crates//:insta",
        "@crates//:proptest",
        "@crates//:criterion",
        "@crates//:tokio",
    ],
)

# Integration test: parse panic-safety / data-loss regressions.
#
# This target exercises the panic path through DocumentIndex::from_text,
# which under the bug swallows a tree-sitter off-by-one via catch_unwind
# and silently drops content blocks. See the test file for full context.
#
# Integration tests under tests/*.rs are NOT covered by the unit-test target
# above (which uses `crate = ":markymark-index"`). Each integration test file
# needs its own rust_test target with `srcs = ["tests/name.rs"]`. A follow-up
# should add targets for every other file in tests/ — currently cargo runs
# them but Bazel CI does not.
rust_test(
    name = "parse_robustness_test",
    srcs = ["tests/parse_robustness.rs"],
    edition = "2021",
    deps = [":markymark-index"],
)

# Criterion benchmark: index construction paths (via_extraction vs direct)
rust_binary(
    name = "bench_index_construction",
    srcs = ["benches/index_construction.rs"],
    deps = [
        ":markymark-index-bench",
        "//markymark-kernels",
        "@crates//:criterion",
    ],
    testonly = True,
    tags = ["bench"],
)
